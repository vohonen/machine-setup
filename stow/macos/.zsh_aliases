# listing
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# dir movement
alias cd..='cd ..'
alias cdb='cd ..; cd ..'
mkcd () { mkdir -p -- "$1" && cd -P -- "$1"; }

# productivity vault: start the day reading the reminders (Muista)
alias start='cd ~/vault/; nvim reminders.md'

# productivity vault: weekly review (Fri) — opens this week's file, creating it
# from the template if missing (cp -n = no-clobber). ISO week, e.g. 2026-W26.
alias review='cd ~/vault/; mkdir -p weekly; cp -n templates/weekly.md weekly/$(date +%G-W%V).md; nvim weekly/$(date +%G-W%V).md'

# misc (note: NO `alias open='xdg-open'` - macOS `open` is native and wanted)
cpclb () {
  if (( $# != 1 )); then
    print -u2 "usage: cpclb <file>"
    return 2
  fi
  if [[ ! -f "$1" ]]; then
    print -u2 "cpclb: not a regular file: $1"
    return 1
  fi
  pbcopy < "$1"
}

alias so='source'
alias fl='file `ls`'
alias dt='date +"%T"'
alias filecount='ls -l | grep -v ^d | grep -v ^t | grep -v ^l | wc -l'

# rl-exploration: RunPod pods. `pod list` for ids and ssh targets,
# `pod cmds <id>` for the scp+ssh block with ip and port filled in.
# The script cd's to the repo root itself, so this works from anywhere.
alias pod='~/projects/rl-exploration/tools/pod'

# cd to relevant dirs
alias cdrl='cd ~/projects/rl-exploration/'
alias cdms='cd ~/machine-setup/'
alias cdv='cd ~/vault/'
